# ==========================================
# Gemini Faceless YouTube Shorts Automator
# ==========================================

# 1. Optional Concept Generation
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# 2. YouTube Data API v3 Credentials
# Download client_secrets.json from Google Cloud Console (OAuth 2.0 Client ID for Desktop App)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Default upload privacy: "public", "unlisted", or "private"
YOUTUBE_PRIVACY_STATUS=public

# 3. Audio & Voiceover Configuration
# Engine: "edge-tts" (free, no key needed) or "elevenlabs"
TTS_ENGINE=edge-tts
# Edge-TTS voices: en-US-ChristopherNeural, en-US-BrianNeural, en-US-GuyNeural, en-GB-RyanNeural
EDGE_TTS_VOICE=en-US-ChristopherNeural
# Optional: ElevenLabs key & voice ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 4. Video & Output Settings
# Shorts standard resolution (9:16 aspect ratio)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MAX_DURATION_SECONDS=15
NUM_SCENES=5

# 5. Pipeline Mode
DRY_RUN=false
# Daily target uploads (24 uploads a day, 1 per hour)
DAILY_TARGET_SHORTS=24
